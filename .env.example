# copia este archivo a ".env" (no lo subas a git) y cambia los valores
DB_ROOT_PASSWORD=cambia_esta_clave_root
DB_USER=vitalpet
DB_PASSWORD=cambia_esta_clave

# integracion con ms-pets (el de nacho)
# false = ms-appointments funciona solo, acepta cualquier petId
# true  = valida contra ms-pets que la mascota exista, este activa y sea del dueno
PETS_VALIDATION_ENABLED=false
# url de ms-pets (ip publica o privada de la ec2 de nacho), solo se usa si lo de arriba es true
PETS_SERVICE_URL=http://IP_DE_MS_PETS:8083

# cors
# "*" permite cualquier origen, en produccion pon el origen del front, ej: http://mi-front.com
CORS_ALLOWED_ORIGINS=*
